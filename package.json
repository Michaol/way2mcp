{
  "name": "way2mcp",
  "version": "1.1.3",
  "description": "MCP transport bridge — convert between stdio and Streamable HTTP",
  "keywords": [
    "mcp",
    "stdio",
    "streamable-http",
    "gateway",
    "bridge"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "way2mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "author": "michaol",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.json' '.prettierrc'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.json' '.prettierrc'",
    "test": "node --test --import tsx/esm tests/bridge.test.ts && node --test --import tsx/esm tests/auto-detect.test.ts && node --test --import tsx/esm tests/bridge-e2e.test.ts && node --test --import tsx/esm tests/serve.test.ts",
    "clean": "rimraf dist dist-tests *.db *.db-shm *.db-wal",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "yargs": "^17.7.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.18",
    "@types/yargs": "^17.0.33",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
